{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/core/**",
              "ui_kits/users-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lato|Roboto|Inter|Poppins|Noto Serif))/i]",
        "message": "Font not provided by the design system. Available: Lato, Roboto, Inter, Poppins, Noto Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlphabeticLight'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|text4|key|ref|className|style|children)$/]",
        "message": "<AlphabeticLight> doesn't accept that prop. Declared props: className, style, text1, text2, text3, text4."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuildingBlocksHeadline'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|headline|text1|key|ref|className|style|children)$/]",
        "message": "<BuildingBlocksHeadline> doesn't accept that prop. Declared props: className, style, headline, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuildingBlocksNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|style2|state|showIcon|icon|badgeLabelText|labelText|showBadgeLabel|key|ref|className|style|children)$/]",
        "message": "<BuildingBlocksNavItem> doesn't accept that prop. Declared props: className, style, style2, state, showIcon, icon, badgeLabelText, labelText, showBadgeLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuildingBlocksNavItem'] > JSXAttribute[name.name='style2'] > Literal[value!=/^(?:active|inactive)$/]",
        "message": "<BuildingBlocksNavItem> style2 must be one of 'active' | 'inactive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuildingBlocksNavItem'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:enabled|hovered|focused|pressed)$/]",
        "message": "<BuildingBlocksNavItem> state must be one of 'enabled' | 'hovered' | 'focused' | 'pressed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuildingBlocksSectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|headline|key|ref|className|style|children)$/]",
        "message": "<BuildingBlocksSectionHeader> doesn't accept that prop. Declared props: className, style, headline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|size|type|outline|state|iconOnly|iconLeft|iconRight|icon1|icon2|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: className, style, size, type, outline, state, iconOnly, iconLeft, iconRight, icon1, icon2."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|secondary|link|danger|dark|info|light|success|warning)$/]",
        "message": "<Button> type must be one of 'primary' | 'secondary' | 'link' | 'danger' | 'dark' | 'info' | 'light' | 'success' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:normal|hovered|active|animating|disabled)$/]",
        "message": "<Button> state must be one of 'normal' | 'hovered' | 'active' | 'animating' | 'disabled'."
