        "message": "<IconWrapper> doesn't accept that prop. Declared props: className, style, union, size, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconWrapper'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:custom|10px|12px|14px|16px|18px|20px|22px|24px|32px|48px|64px|104px|128px)$/]",
        "message": "<IconWrapper> size must be one of 'custom' | '10px' | '12px' | '14px' | '16px' | '18px' | '20px' | '22px' | '24px' | '32px' | '48px' | '64px' | '104px' | '128px'."
