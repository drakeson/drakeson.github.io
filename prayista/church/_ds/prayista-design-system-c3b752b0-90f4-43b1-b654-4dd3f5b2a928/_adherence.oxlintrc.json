        "selector": "JSXOpeningElement[name.name='Cancel'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|key|ref|className|style|children)$/]",
        "message": "<Cancel> doesn't accept that prop. Declared props: className, style, text1."
      },
